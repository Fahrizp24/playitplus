# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# 1. UNIFIED LLM CONFIGURATION (Agnostik Vendor / Tanpa Kunci Vendor)
# Mendukung endpoint apa saja yang kompatibel dengan standar OpenAI, termasuk:
# - OpenRouter (https://openrouter.ai/api/v1) -> Claude, Llama, DeepSeek, Gemini, dll.
# - OpenAI (https://api.openai.com/v1)
# - Groq (https://api.groq.com/openai/v1)
# - DeepSeek (https://api.deepseek.com/v1)
# - Local Ollama / vLLM (http://localhost:11434/v1)
# ==============================================================================
# Pilihan mode: "unified" | "gemini" | "mock"
# Default: "mock" (bisa langsung jalan tanpa isi key untuk simulasi klinis)
LLM_PROVIDER=mock

# Masukkan API Key dari penyedia mana saja yang Anda gunakan (OpenRouter, Groq, dll)
LLM_API_KEY=

# Base URL provider (default: OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model ID sesuai dengan provider yang Anda pakai
# Contoh OpenRouter: anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001, deepseek/deepseek-chat
# Contoh Groq:       llama-3.3-70b-versatile
# Contoh OpenAI:     gpt-4o-mini
LLM_MODEL=anthropic/claude-3.5-sonnet

# (Opsional) Langsung via Google Gemini API:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# 2. UNIFIED STT (Speech-to-Text / Transkripsi Suara)
# Mendukung provider audio transcription OpenAI-compatible (Groq Whisper, OpenAI Whisper, dll)
# ==============================================================================
# Pilihan mode: "unified" | "mock"
STT_PROVIDER=mock

# Masukkan API Key STT (misal dari Groq atau OpenAI)
STT_API_KEY=

# Base URL endpoint audio transcription:
# Contoh Groq (Sangat Cepat & Murah): https://api.groq.com/openai/v1
# Contoh OpenAI:                      https://api.openai.com/v1
STT_BASE_URL=https://api.groq.com/openai/v1

# Model ID Whisper:
# Groq:   whisper-large-v3-turbo
# OpenAI: whisper-1
STT_MODEL=whisper-large-v3-turbo
