# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# 1. UNIFIED LLM (Agnostik Vendor / Tanpa Vendor Lock)
# Mendukung provider apa saja dengan endpoint standar OpenAI (OpenRouter, Groq, OpenAI, Ollama, dll)
# ==============================================================================
# Mode provider: "unified" (jika pakai API) | "mock" (simulasi offline)
LLM_PROVIDER=mock

# Masukkan API Key dari platform yang Anda gunakan (OpenRouter, Groq, OpenAI, dll)
LLM_API_KEY=

# Base URL provider Anda
# Contoh OpenRouter:               https://openrouter.ai/api/v1
# Contoh Groq:                     https://api.groq.com/openai/v1
# Contoh OpenAI:                   https://api.openai.com/v1
# Contoh Gemini (OpenAI-compat):   https://generativelanguage.googleapis.com/v1beta/openai/
# Contoh DeepSeek:                 https://api.deepseek.com/v1
# Contoh Ollama:                   http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model ID yang ingin Anda gunakan
# Contoh OpenRouter: anthropic/claude-3.5-sonnet
#                    google/gemini-2.0-flash-001
#                    meta-llama/llama-3.3-70b-instruct
#                    deepseek/deepseek-chat
# Contoh Groq:       llama-3.3-70b-versatile
# Contoh OpenAI:     gpt-4o-mini
# Contoh Gemini:     gemini-2.5-flash
LLM_MODEL=anthropic/claude-3.5-sonnet

# ==============================================================================
# 2. UNIFIED STT (Speech-to-Text / Transkripsi Suara)
# Mendukung provider audio transcription OpenAI-compatible (Groq Whisper, OpenAI Whisper, dll)
# ==============================================================================
# Mode provider: "unified" (jika pakai API) | "mock" (simulasi offline)
STT_PROVIDER=mock

# Masukkan API Key STT (misal dari Groq atau OpenAI)
STT_API_KEY=

# Base URL endpoint audio transcription:
# Contoh Groq:   https://api.groq.com/openai/v1
# Contoh OpenAI: https://api.openai.com/v1
STT_BASE_URL=https://api.groq.com/openai/v1

# Model ID Whisper yang ingin digunakan:
# Contoh Groq:   whisper-large-v3-turbo
# Contoh OpenAI: whisper-1
STT_MODEL=whisper-large-v3-turbo
