# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# STT (Speech-to-Text) Provider
# Options: mock | groq | openai
STT_PROVIDER=mock

# STT API Keys (isi sesuai provider pilihan)
GROQ_API_KEY=
OPENAI_API_KEY=

# LLM Provider (untuk Deidentifikasi Lanjutan & Auto-Fill SOAP)
# Options: mock | gemini | openai | groq
LLM_PROVIDER=mock

# LLM API Keys (isi sesuai provider pilihan)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Model Overrides (Opsional)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# GROQ_STT_MODEL=whisper-large-v3-turbo
# OPENAI_STT_MODEL=whisper-1
